{
  // 只做类型检查、不编译：源码仍是纯 JS，类型写在 JSDoc 里（npm run typecheck）
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.collection"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "test/**/*.js"]
}
