# 复制为 .env 后按需修改；不创建 .env 也能用默认值启动。
# src/core/config.js 用 Node 内置的 process.loadEnvFile() 读取，系统环境变量优先级更高。
# 某项填写有误时不会直接崩溃：该项回退为默认值，启动时统一提示，npm run doctor 也会列出。

# ---------- Ollama ----------
OLLAMA_HOST=http://127.0.0.1:11434
# 对话模型，需要支持 tool calling
CHAT_MODEL=qwen3.5:9b
# 向量模型。⚠️ 更换后必须执行：npm run reset && npm run ingest
EMBED_MODEL=bge-m3

# ---------- Chroma ----------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION=personal_kb

# ---------- RAG ----------
# 每次检索返回的片段数
TOP_K=4
# 相似度低于该值（0~1）的片段会被丢弃，不交给模型、也不列为参考来源；设为 0 即关闭过滤。
# bge-m3 实测：相关问题最高分约 0.49~0.74，无关问题约 0.30~0.47
MIN_SIMILARITY=0.45
# 每个片段的字符数与重叠字符数（overlap 可以为 0，但不能超过 size 的一半）
CHUNK_SIZE=512
CHUNK_OVERLAP=60
# Agent 最多追加检索几轮
MAX_TOOL_ROUNDS=5
# 对话保留的最近问答轮数
HISTORY_TURNS=7
# 多轮对话时，先让模型结合上下文把「它是做什么用的？」这类追问改写成独立问题再检索（多一次本地模型调用，约 2 秒）
QUERY_REWRITE=true

# ---------- 输出 ----------
# 交互式对话是否展示模型的思考过程（message.thinking），可用 /thinking 临时切换
# 只影响 npm start；npm run ask 不受它影响，需要时用 npm run ask -- --thinking "问题"（打印到 stderr）
SHOW_THINKING=true

# ---------- 联网搜索（默认关闭） ----------
# 开启后，本地资料不足或问题涉及时效性信息时，助手会用 Tavily 联网检索，每个问题最多 1 次。
# ⚠️ 联网时你输入的问题原文会发送给 Tavily；文档、知识库片段与对话历史不会外发。
WEB_SEARCH=false
# 开启 WEB_SEARCH 时必填，在 https://app.tavily.com 免费注册获取（tvly- 开头）。切勿提交到仓库。
TAVILY_API_KEY=

# ---------- 文档 ----------
# 相对路径以项目根目录为基准，与从哪个目录启动无关
DOCS_DIR=docs
