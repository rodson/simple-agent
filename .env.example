# 复制为 .env 后按需修改；不创建 .env 也能用默认值启动。
# src/config.js 内置极简 KEY=VALUE 读取器，系统环境变量优先级更高。

# ---------- Ollama ----------
OLLAMA_HOST=http://127.0.0.1:11434
# 对话模型，需要支持 tool calling
CHAT_MODEL=qwen3.5:9b
# 向量模型。⚠️ 更换后必须执行：npm run reset && npm run ingest
EMBED_MODEL=bge-m3

# ---------- Chroma ----------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION=personal_kb

# ---------- RAG ----------
# 每次检索返回的片段数
TOP_K=4
# 每个片段的字符数与重叠字符数（overlap 不能超过 size 的一半）
CHUNK_SIZE=512
CHUNK_OVERLAP=60
# Agent 最多追加检索几轮
MAX_TOOL_ROUNDS=5
# 对话保留的最近问答轮数
HISTORY_TURNS=7

# ---------- 输出 ----------
# 交互式对话是否展示模型的思考过程（message.thinking），可用 /thinking 临时切换
# npm run ask 默认始终不展示；显式设为 true 时会把思考过程打印到 stderr
SHOW_THINKING=true

# ---------- 文档 ----------
DOCS_DIR=docs
