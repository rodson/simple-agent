# 复制为 .env 后按需修改；不创建 .env 也能用默认值启动。
# src/config.js 内置极简 KEY=VALUE 读取器，系统环境变量优先级更高。

# ---------- Ollama ----------
OLLAMA_HOST=http://127.0.0.1:11434
# 对话模型，需要支持 tool calling
CHAT_MODEL=qwen2.5:3b
# 向量模型。⚠️ 更换后必须执行：npm run reset && npm run ingest
EMBED_MODEL=bge-m3

# ---------- Chroma ----------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION=personal_kb

# ---------- RAG ----------
# 每次检索返回的片段数
TOP_K=4
# 每个片段的字符数与重叠字符数（overlap 不能超过 size 的一半）
CHUNK_SIZE=512
CHUNK_OVERLAP=60
# Agent 最多追加检索几轮
MAX_TOOL_ROUNDS=3
# 对话保留的最近问答轮数
HISTORY_TURNS=5

# ---------- 文档 ----------
DOCS_DIR=docs
